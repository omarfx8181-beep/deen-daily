{"n":112,"name":"Al-Ikhlas","meaning":"Sincerity","ayahs":4,"startPage":604,"verses":[{"i":1,"ar":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","tr":"Qul huwa Allahu ahadun","en":"Say, \"He is Allah, [who is] One"},{"i":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allahu alssamadu","en":"Allah, the Eternal Refuge"},{"i":3,"ar":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","tr":"Lam yalid walam yooladu","en":"He neither begets nor is born"},{"i":4,"ar":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","tr":"Walam yakun lahu kufuwan ahadun","en":"Nor is there to Him any equivalent"}]}