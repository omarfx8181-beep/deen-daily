{"n":114,"name":"An-Nas","meaning":"Mankind","ayahs":6,"startPage":604,"verses":[{"i":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Qul aAAoothu birabbi alnnasi","en":"Say, \"I seek refuge in the Lord of mankind"},{"i":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"Maliki alnnasi","en":"The Sovereign of mankind"},{"i":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"Ilahi alnnasi","en":"The God of mankind"},{"i":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","tr":"Min sharri alwaswasi alkhannasi","en":"From the evil of the retreating whisperer"},{"i":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","tr":"Allathee yuwaswisu fee sudoori alnnasi","en":"Who whispers [evil] into the breasts of mankind"},{"i":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","tr":"Mina aljinnati wa alnnasm","en":"From among the jinn and mankind"}]}