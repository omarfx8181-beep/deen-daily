{"n":107,"name":"Al-Ma'un","meaning":"Small Kindnesses","ayahs":7,"startPage":602,"verses":[{"i":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","tr":"Araayta allathee yukaththibu bialddeeni","en":"Have you seen the one who denies the Recompense"},{"i":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","tr":"Fathalika allathee yaduAAAAu alyateema","en":"For that is the one who drives away the orphan"},{"i":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","tr":"Wala yahuddu AAala taAAami almiskeeni","en":"And does not encourage the feeding of the poor"},{"i":4,"ar":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","tr":"Fawaylun lilmusalleena","en":"So woe to those who pray"},{"i":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","tr":"Allatheena hum AAan salatihim sahoona","en":"[But] who are heedless of their prayer"},{"i":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","tr":"Allatheena hum yuraoona","en":"Those who make show [of their deeds]"},{"i":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","tr":"WayamnaAAoona almaAAoona","en":"And withhold [simple] assistance"}]}